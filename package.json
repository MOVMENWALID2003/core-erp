{
  "name": "core-erp",
  "productName": "CORE ERP",
  "version": "1.0.1",
  "author": "MOAMEN ELBARADEI",
  "description": "CORE ERP local-first warehouse and inventory management desktop application",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env DEV=1 electron .\"",
    "build": "vite build",
    "prestart": "npm run build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.moamenelbaradei.coreerp",
    "productName": "CORE ERP",
    "directories": {
      "output": "dist_installer"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CORE ERP"
    },
    "publish": {
      "provider": "github",
      "owner": "MOVMENWALID2003",
      "repo": "core-erp"
    }
  }
}
